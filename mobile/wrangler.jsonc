// Вэб хувилбар (Expo web export → dist/) багийн Cloudflare дээр: https://kumalearn.online
// (хуучин https://surgalt.pinequest-team1.workers.dev ч ажилласаар байна).
// Build: EXPO_PUBLIC_API_URL=https://surgalt-api.pinequest-team1.workers.dev npx expo export -p web
// Deploy: ../api/node_modules/.bin/wrangler deploy (api/-ийн wrangler-ийг ашиглана)
{
  "$schema": "../api/node_modules/wrangler/config-schema.json",
  "name": "surgalt",
  "account_id": "7b528e45cb6c0f796a92b9f437c87281",
  "compatibility_date": "2026-10-01",
  // Домэйн (GoDaddy-аас авсан, DNS нь багийн Cloudflare дээр). Deploy бүр энэ жагсаалтаар Worker-ын
  // custom domain-уудыг солино. workers.dev-ийг тодорхой асаасан нь хуучин холбоос, апп-ын build эвдрэхгүй.
  "routes": [
    { "pattern": "kumalearn.online", "custom_domain": true },
    { "pattern": "www.kumalearn.online", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    // expo-router-ийн web.output = 'single': /login, /task/math зэрэг бүх замд index.html-ийг өгнө.
    "not_found_handling": "single-page-application"
  }
}
