{
  "name": "surgalt-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ai": "node scripts/dev.mjs --env ai",
    "dev:books": "node scripts/dev.mjs --env books",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply BOOKS --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote && wrangler d1 migrations apply BOOKS --remote",
    "books:migrate:remote": "wrangler d1 migrations apply BOOKS --remote --env books",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate",
    "typecheck": "wrangler types --strict-vars=false >/dev/null && tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "seed:questions": "tsx scripts/seed-questions.ts",
    "seed:fixtures": "tsx scripts/seed-questions.ts --fixtures",
    "questions:export": "tsx scripts/seed-questions.ts --export seed/questions.json",
    "questions:import": "tsx scripts/seed-questions.ts --fixtures --file seed/questions.json",
    "books:import": "tsx scripts/books.ts import",
    "books:list": "tsx scripts/books.ts list",
    "books:page": "tsx scripts/books.ts page",
    "books:ocr": "tsx scripts/books.ts ocr",
    "books:delete": "tsx scripts/books.ts delete",
    "bot": "tsx scripts/duel-bot.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
