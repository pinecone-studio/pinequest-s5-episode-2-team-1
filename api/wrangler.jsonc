{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "surgalt-api",
  // Багийн Cloudflare account (pinequest-team1.workers.dev): олон account-тай гишүүнд ч энэ account сонгогдоно.
  "account_id": "7b528e45cb6c0f796a92b9f437c87281",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Local dev-д database_id-ийн утга хамаагүй (зөвхөн давхардахгүй байх ёстой). workers.dev руу deploy
  // хийхдээ `npx wrangler d1 create surgalt` (`surgalt-books`)-ийн гаргасан id-аар солино (README).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "surgalt",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    // Сурах бичгийн сан (ном, хуудас). Тоглоомын DB-ээс тусдаа: local-д `db:reset` хийсэн ч
    // `npm run books:import` хавтаснаас нь сэргээнэ, дараа нь багийн Cloudflare руу дангаар нь шилжинэ.
    // Local-д database_id нь файлын нэр болдог тул DB-ийнхээс өөр байх ёстой.
    {
      "binding": "BOOKS",
      "database_name": "surgalt-books",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations-books"
    }
  ],
  // Хуудас бүрийн эх файл (скан PDF-ийн хуудас, зураг). Local-д .wrangler/state дотор хадгалагдана.
  "r2_buckets": [{ "binding": "BOOK_FILES", "bucket_name": "surgalt-books" }],

  "durable_objects": {
    "bindings": [{ "name": "DUEL_ROOM", "class_name": "DuelRoom" }]
  },
  // SQLite-backed Durable Object → Free plan дээр deploy хийж болно.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DuelRoom"] }],

  "vars": {
    // "gemini" | "workers-ai". Хоосон бол GEMINI_API_KEY байвал gemini, үгүй бол workers-ai.
    "LLM_PROVIDER": "",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_THINKING_LEVEL": "low",
    "GEMINI_LIVE_MODEL": "gemini-3.8-live",
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },

  // Workers AI binding local dev-д ч Cloudflare руу ханддаг тул нэвтрэлт (`npx wrangler login`)
  // шаардана. Үндсэн орчныг нэвтрэлтгүй ажиллуулахын тулд тусад нь: `npm run dev:ai`.
  "env": {
    // `npm run dev:books`: тоглоомын DB local хэвээр, сурах бичгийн сан (BOOKS, BOOK_FILES) нь багийн
    // Cloudflare дээрх жинхэнэ сан (remote). `npx wrangler login` шаардана.
    "books": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "surgalt",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        },
        {
          "binding": "BOOKS",
          "database_name": "surgalt-books",
          "database_id": "24a6924d-6e68-40f0-896d-d00fbd93afe9",
          "migrations_dir": "migrations-books",
          "remote": true
        }
      ],
      "r2_buckets": [{ "binding": "BOOK_FILES", "bucket_name": "surgalt-books", "remote": true }],
      "durable_objects": {
        "bindings": [{ "name": "DUEL_ROOM", "class_name": "DuelRoom" }]
      },
      "vars": {
        "LLM_PROVIDER": "",
        "GEMINI_MODEL": "gemini-3.8-flash",
        "GEMINI_THINKING_LEVEL": "low",
        "GEMINI_LIVE_MODEL": "gemini-3.8-live",
        "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts",
        "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
      }
    },
    "ai": {
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "surgalt",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        },
        {
          "binding": "BOOKS",
          "database_name": "surgalt-books",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations-books"
        }
      ],
      "r2_buckets": [{ "binding": "BOOK_FILES", "bucket_name": "surgalt-books" }],
      "durable_objects": {
        "bindings": [{ "name": "DUEL_ROOM", "class_name": "DuelRoom" }]
      },
      "vars": {
        "LLM_PROVIDER": "workers-ai",
        "GEMINI_MODEL": "gemini-3.8-flash",
        "GEMINI_THINKING_LEVEL": "low",
        "GEMINI_LIVE_MODEL": "gemini-3.8-live",
        "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts",
        "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
      }
    },
    // `npm run deploy` / `npm run db:migrate:remote`: багийн Cloudflare дээрх жинхэнэ орчин
    // (https://surgalt-api.pinequest-team1.workers.dev). Дээд түвшний id-ууд local dev-д зориулсан тул хөндөхгүй.
    "production": {
      "name": "surgalt-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "surgalt",
          "database_id": "60e7eddc-2c6d-4a78-8228-1eb19218694a",
          "migrations_dir": "migrations"
        },
        {
          "binding": "BOOKS",
          "database_name": "surgalt-books",
          "database_id": "24a6924d-6e68-40f0-896d-d00fbd93afe9",
          "migrations_dir": "migrations-books"
        }
      ],
      "r2_buckets": [{ "binding": "BOOK_FILES", "bucket_name": "surgalt-books" }],
      "durable_objects": {
        "bindings": [{ "name": "DUEL_ROOM", "class_name": "DuelRoom" }]
      },
      "vars": {
        "LLM_PROVIDER": "",
        "GEMINI_MODEL": "gemini-3.8-flash",
        "GEMINI_THINKING_LEVEL": "low",
        "GEMINI_LIVE_MODEL": "gemini-3.8-live",
        "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts",
        // Баавгайн хэлэх үгийг Gemini TTS (Achird) уншина; түлхүүр нь GEMINI_TTS_API_KEY secret.
        "TUTOR_SPEECH": "tts",
        "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
      }
    }
  }
}
