{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "ESNext.TypedArrays", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["./*.ts", "../../shared"]
}
