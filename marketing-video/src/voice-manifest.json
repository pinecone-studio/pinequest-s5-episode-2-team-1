[
  {
    "file": "voice/line-0.wav",
    "from": 0,
    "frames": 51,
    "text": "Хичээл давтах уйтгартай юу?"
  },
  {
    "file": "voice/line-1.wav",
    "from": 54,
    "frames": 29,
    "text": "Тоглоом болгоё!"
  },
  {
    "file": "voice/line-2.wav",
    "from": 100,
    "frames": 99,
    "text": "Энэ бол Кума. Баавгайтайгаа хамт өдөр бүр сур."
  },
  {
    "file": "voice/line-3.wav",
    "from": 218,
    "frames": 99,
    "text": "Сурах бичгийн сэдэв бүр адал явдлын газрын зураг дээр."
  },
  {
    "file": "voice/line-4.wav",
    "from": 338,
    "frames": 99,
    "text": "Даалгавар хийж оноо цуглуулаад, баавгайгаа хувцасла."
  },
  {
    "file": "voice/line-5.wav",
    "from": 458,
    "frames": 44,
    "text": "Найзтайгаа хичээлээрээ өрсөлд!"
  },
  {
    "file": "voice/line-6.wav",
    "from": 580,
    "frames": 89,
    "text": "Зургаагаас арван хоёрдугаар ангийн математик, тоглоом шиг."
  },
  {
    "file": "voice/line-7.wav",
    "from": 744,
    "frames": 61,
    "text": "Кумаг одоо туршаад үз!"
  }
]
